# Public repository allowlist. Local specifications and reports stay on disk.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/deployment.config.json
!/package.json
!/package-lock.json
!/index.html
!/vite.config.ts
!/vitest.config.ts
!/playwright.config.ts
!/tsconfig.json
!/tsconfig.sw.json
!/eslint.config.js
!/src/
!/public/
!/tests/
!/scripts/
!/shared/
!/backend/

node_modules/
dist/
handoff/
evidence/
test-results/
playwright-report/
.npm-cache/
debug.log
*.log
.env
.env.*
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
*.pem
*.key
*.pfx
*.mp4
*.mov
*.MOV
*.webm
!tests/fixtures/synthetic.webm
