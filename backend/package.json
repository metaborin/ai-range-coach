{
  "name": "ai-range-coach-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "wrangler dev --env development",
    "deploy": "wrangler deploy --env=\"\"",
    "dry-run": "wrangler deploy --env=\"\" --dry-run --outdir dist/deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "jpeg-js": "0.4.4",
    "miniflare": "5.20260903.0-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  }
}
